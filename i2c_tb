module tb;
  reg clk,rst;
  reg [7:0]w_data;
  reg [6:0]addr;
  reg rw;
  reg enable;
  wire [7:0]dout;
  wire i2c_sda;
  wire i2c_scl;
  
  master dut1(.clk(clk),.rst(rst),.w_data(w_data),.addr(addr),.rw(rw),.enable(enable),.dout(dout),.i2c_sda(i2c_sda),.i2c_scl(i2c_scl));
  slave dut2(.sda(i2c_sda),.scl(i2c_scl));
  
  always #10 clk=~clk;
  initial begin
    rst=1'b1;
    clk=1'b0;
    w_data=8'd0;
    addr=7'd0;
    rw=1'b0;
    enable=1'b0;
  end
  initial begin
    #5000;
    rst=0;
    enable=1'b1;
    addr=7'b0101010;
    w_data=8'd43;
    rw=0;
    #160;
    enable=1'b0;
    #3000;
    enable=1'b1;
    addr=7'b0101010;
    rw=1;
    #160;
    enable=1'b0;
    #5000;
    $finish;
  end
endmodule
    
